{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "world-of-evolving-paths": ["src/index.ts"],
      "world-of-evolving-paths/react": ["src/react/index.ts"]
    }
  },
  "include": ["src", "demo", "tests", "vite.config.ts", "vite.lib.config.ts", "vitest.config.ts"]
}
