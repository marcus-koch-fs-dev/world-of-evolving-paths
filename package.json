{
  "name": "world-of-evolving-paths",
  "version": "0.0.5",
  "description": "Evolving, date-based paths on a pannable, zoomable canvas.",
  "type": "module",
  "license": "MIT",
  "author": "Marcus Koch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcus-koch-fs-dev/world-of-evolving-paths.git"
  },
  "homepage": "https://github.com/marcus-koch-fs-dev/world-of-evolving-paths#readme",
  "bugs": {
    "url": "https://github.com/marcus-koch-fs-dev/world-of-evolving-paths/issues"
  },
  "keywords": [
    "timeline",
    "paths",
    "canvas",
    "pixi",
    "pixijs",
    "webgl",
    "react",
    "typescript",
    "visualization",
    "habits",
    "habit-tracker",
    "skill-tree",
    "roadmap",
    "milestones",
    "goals",
    "progress",
    "map",
    "interactive-map",
    "zoom",
    "pan"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
